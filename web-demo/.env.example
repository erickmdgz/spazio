# Spazio web demo — environment configuration
#
# The demo runs fully WITHOUT any of these values (it uses the offline
# CachedRenderProvider). These are only needed to enable live AI renders.

# Which render provider to use: "cached" (default, offline) or "openai".
# If unset, the app auto-selects: "openai" when IMAGE_API_KEY is present,
# otherwise "cached".
RENDER_PROVIDER=cached

# API key for the hosted image-generation provider.
# Leave EMPTY for the demo. When set (and RENDER_PROVIDER is not "cached"),
# the app attempts live renders and falls back to cached on any error.
IMAGE_API_KEY=
