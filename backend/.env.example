# Spazio pilot backend — example environment.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (Postgres, ADR-001) ---
# docker compose up db  ->  spazio/spazio on localhost:5432
DATABASE_URL=postgresql://spazio:spazio@localhost:5432/spazio?schema=public

# --- Operator auth (console sessions, plan §1.7/§1.8; see src/auth/operator.ts) ---
# Signs the operator session cookie. Min 16 chars; rotate to revoke all sessions.
OPERATOR_SESSION_SECRET=dev-session-secret-change-me
# Console shell location served at /operator/console (relative to backend/).
OPERATOR_CONSOLE_DIR=../operator/public

# --- Object storage (private photos/renders) ---
# Pilot dev impl is local disk. Vendor fields are placeholders only (no real vendor).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Render pipeline (hosted generative image API, ADR-002) ---
# Pilot dev impl is a fake pipeline. Vendor fields are placeholders only.
RENDER_DRIVER=fake
RENDER_API_URL=
RENDER_API_KEY=

# --- Payments (single PCI-compliant COP capture, ADR-003/004) ---
# Pilot dev impl is a fake gateway. Vendor fields are placeholders only.
PAYMENT_DRIVER=fake
PAYMENT_API_URL=
PAYMENT_API_KEY=

# --- Queue (async render jobs) ---
# Pilot dev impl is in-memory. A real broker URL is a placeholder only.
QUEUE_DRIVER=memory
QUEUE_URL=
