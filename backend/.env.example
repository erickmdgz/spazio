# Spazio pilot backend — example environment.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (Postgres, ADR-001) ---
# docker compose up db  ->  spazio/spazio on localhost:5432
DATABASE_URL=postgresql://spazio:spazio@localhost:5432/spazio?schema=public

# --- Operator auth (console sessions, plan §1.7/§1.8; see src/auth/operator.ts) ---
# Signs the operator session cookie. Min 16 chars; rotate to revoke all sessions.
OPERATOR_SESSION_SECRET=dev-session-secret-change-me
# Console shell location served at /operator/console (relative to backend/).
OPERATOR_CONSOLE_DIR=../operator/public

# --- Object storage (private photos/renders) ---
# Pilot dev impl is local disk. Vendor fields are placeholders only (no real vendor).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Render engine (ADR-026: self-hosted FLUX.2 Klein 4B via mflux) ---
# fake  = deterministic, no external calls (default; keeps dev/CI hermetic).
# mflux = self-hosted FLUX.2 Klein 4B run via the mflux CLI as a child process.
#         Requires an Apple-Silicon render host with mflux installed (ADR-026).
# The MFLUX_* fields are child-process settings only — NO secrets, no vendor API.
RENDER_ENGINE=fake
MFLUX_EDIT_BIN=mflux-generate-flux2-edit
MFLUX_MODEL=flux2-klein-4b
MFLUX_STEPS=8
MFLUX_QUANTIZE=8
# Downscale every input image to this longest edge (px) before mflux, so a large
# phone photo (~24 MP) can't OOM the Metal backend (BUG-001). 0 disables.
MFLUX_MAX_IMAGE_EDGE=1280
# Python for the Pillow downscale (ships with the mflux venv — no new dependency).
# Leave empty to derive it from MFLUX_EDIT_BIN's directory.
MFLUX_PYTHON_BIN=
# Hard cap (ms) on a single render (BUG-002 / NFR-004). A hung mflux child (OOM,
# model never loads) is SIGKILLed at this cap and the render fails, so a request
# never spins forever and no orphan child survives past it. Default 360000 = 6 min.
RENDER_TIMEOUT_MS=360000

# --- Payments (single PCI-compliant COP capture, ADR-003/004) ---
# Pilot dev impl is a fake gateway. Vendor fields are placeholders only.
PAYMENT_DRIVER=fake
PAYMENT_API_URL=
PAYMENT_API_KEY=

# --- Queue (async render jobs) ---
# Pilot dev impl is in-memory. A real broker URL is a placeholder only.
QUEUE_DRIVER=memory
QUEUE_URL=
